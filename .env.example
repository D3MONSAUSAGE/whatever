# Public. Project URL, e.g. https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# Public. Publishable key (sb_publishable_...) or the legacy anon key.
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-publishable-or-anon-key
# Server only. Secret key (sb_secret_...) or the legacy service_role key.
# Never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=your-secret-or-service-role-key
# Server only. Generate with: openssl rand -hex 32
PAIRING_CODE_SECRET=change-me-to-a-long-random-string
# Server only. Vercel Cron sends this as Authorization: Bearer <CRON_SECRET>.
# If unset, GET /api/cron/orphan-uploads returns 503 and deletes nothing.
# openssl rand -hex 32
CRON_SECRET=
# Server only. Signing secret for POST /api/webhooks/resend-receiving
# (Resend email.received). Separate from any sending-webhook secret.
# If unset, the route returns 503 and does not forward mail.
RESEND_INBOUND_WEBHOOK_SECRET=
# Server only. E4 one-time welcome email (uses EMAIL_PROVIDER/RESEND_API_KEY/ALERT_EMAIL_FROM).
# Leave off until Confirm email is on. WELCOME_EMAIL_SINCE is an ISO time; only accounts created
# at or after it (and within 7 days) get the welcome, so existing customers never do.
WELCOME_EMAIL=
WELCOME_EMAIL_SINCE=
# Server only. I18N-5 Supabase Auth Send Email Hook secret, as shown by Supabase
# (Authentication > Hooks > Send Email): "v1,whsec_...". Reuses RESEND_API_KEY. If unset,
# POST /api/webhooks/supabase-send-email answers 500 and sends nothing. The hook stays OFF in
# Supabase until enabled by hand (docs/auth-email-hook.md).
SUPABASE_SEND_EMAIL_HOOK_SECRET=
