# Public. Project URL, e.g. https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# Public. Publishable key (sb_publishable_...) or the legacy anon key.
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-publishable-or-anon-key
# Server only. Secret key (sb_secret_...) or the legacy service_role key.
# Never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=your-secret-or-service-role-key
# Server only. Generate with: openssl rand -hex 32
PAIRING_CODE_SECRET=change-me-to-a-long-random-string
# Server only. Vercel Cron sends this as Authorization: Bearer <CRON_SECRET>.
# If unset, GET /api/cron/orphan-uploads returns 503 and deletes nothing.
# openssl rand -hex 32
CRON_SECRET=
